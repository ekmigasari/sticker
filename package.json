{
  "name": "xmigas-fe",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:cloudflare": "VITE_DEPLOY_TARGET=cloudflare vite dev --port 3000",
    "build": "vite build",
    "build:cloudflare": "VITE_DEPLOY_TARGET=cloudflare vite build",
    "preview": "vite preview",
    "preview:cloudflare": "VITE_DEPLOY_TARGET=cloudflare vite preview",
    "deploy:cloudflare": "pnpm build:cloudflare && wrangler deploy",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "lint": "oxlint",
    "format": "oxfmt --write \"src/**/*.{ts,tsx,js,jsx}\"",
    "check": "oxfmt --check \"src/**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "start": "node .output/server/index.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/router-plugin": "^1.168.48",
    "better-auth": "^1.7.12",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.4",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "motion": "^13.2.0",
    "nitro": "3.0.260903-beta",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.15.0",
    "recharts": "3.10.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@tanstack/devtools-vite": "^0.8.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.9",
    "jsdom": "^30.1.3",
