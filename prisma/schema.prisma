// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  /// Better Auth admin plugin: comma-separated roles ("user", "admin").
  role          String?   @default("user")
  /// Banned users can't sign in and their stickers leave every public surface.
  banned        Boolean?  @default(false)
  banReason     String?
  /// Null while banned means the ban is permanent.
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  uploads       Upload[]
  stickers      Sticker[]
  reports       Report[]
  printSheets   PrintSheet[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Upload {
  id          String    @id
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  key         String    @unique
  fileName    String
  contentType String
  sizeBytes   Int
  createdAt   DateTime  @default(now())
  stickers    Sticker[]

  @@index([userId])
  @@map("upload")
}

/**
 * One sticker = one directory listing + primary artwork.
 */
model Sticker {
  id               String      @id
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug             String      @unique
  name             String
  oneLiner         String
  url              String
  category         String
  description      String?
  offer            String?
  offerCode        String?
  offerExpiresOn   DateTime?   @db.Date
  uploadId         String
  upload           Upload      @relation(fields: [uploadId], references: [id], onDelete: Restrict)
  style            String
  filter           String      @default("original")
  /// Sticker material (none, matte, gloss, glitter, hologram).
  finish           String      @default("none")
  outlineColor     String
  outlineThickness Int
  /// Whole dollars paid for wall placements. Ranks are derived from this at read time.
  totalSpent       Int         @default(0)
  /// Click-throughs to `url`, once per visitor per day. The owner's own clicks don't count.
  clicks           Int         @default(0)
  /// Archived stickers leave the directory and rankings; their wall plots stay.
  archivedAt       DateTime?
  /// Taken down by an admin: off the wall, directory and rankings. Owners can't undo it.
  hiddenAt         DateTime?
  hiddenReason     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  placements       Placement[]
  reports          Report[]
  printItems       PrintSheetItem[]
  clickLog         StickerClick[]

  @@index([userId])
  @@index([category])
  @@index([archivedAt])
  @@index([hiddenAt])
  @@index([uploadId])
  @@index([totalSpent(sort: Desc), createdAt])
  @@map("sticker")
}

/// One paid plot on the wall. Newer plots stack on top (higher zIndex).
model Placement {
  id           String   @id
  stickerId    String
  sticker      Sticker  @relation(fields: [stickerId], references: [id], onDelete: Cascade)
  /// Plot top-left and size in wall px (axis-aligned, snapped to whole units).
  x            Int
  y            Int
  width        Int
  height       Int
  unitsW       Int
  unitsH       Int
  zIndex       Int      @unique @default(autoincrement())
  stickerScale Float    @default(1)
  rotation     Float    @default(0)
  offsetX      Float    @default(0)
  offsetY      Float    @default(0)
  /// Share of the plot not covered by newer plots (0–1). 0 = off the wall.
  visibleShare Float    @default(1)
  /// Newer plots overlapping this one.
  coveredBy    Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([stickerId])
  @@index([visibleShare])
  @@index([x, y])
  @@map("placement")
}

/// Better Auth rate-limit rows. `lastRequest` is epoch milliseconds.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

/// Unique visitors per day. The lifetime total is the sum of every day.
model SiteDailyStat {
  day      DateTime @id @db.Date
  visitors Int      @default(0)

  @@map("site_daily_stat")
}

/// Who visited today, so each visitor counts once a day. `visitor` is a hash
/// with a daily salt, never an IP. Older days are pruned.
model SiteVisitor {
  day     DateTime @db.Date
  visitor String

  @@id([day, visitor])
  @@map("site_visitor")
}

/// Who clicked a sticker today, so each visitor counts once per sticker a day.
/// Older days are pruned; `Sticker.clicks` keeps the total.
model StickerClick {
  stickerId String
  sticker   Sticker  @relation(fields: [stickerId], references: [id], onDelete: Cascade)
  day       DateTime @db.Date
  visitor   String

  @@id([stickerId, day, visitor])
  @@index([day])
  @@map("sticker_click")
}

/// Fixed-window counters for application writes (uploads, stickers, reports).
model ApiRateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@map("api_rate_limit")
}

/// A signed-in user flagging a sticker. One open report per person per sticker.
model Report {
  id         String    @id
  stickerId  String
  sticker    Sticker   @relation(fields: [stickerId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User      @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  /// One of the ids in `REPORT_REASONS`.
  reason     String
  details    String    @default("")
  /// open | upheld | dismissed
  status     String    @default("open")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
  @@index([reporterId])
  @@index([stickerId])
  @@map("report")
}

/// A page of stickers someone saved on their account so they can print it again.
model PrintSheet {
  id        String           @id
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  /// a4 | letter | a5 | a3 | custom
  paper     String
  widthMm   Int
  heightMm  Int
  /// Default longest side, in millimetres, for a sticker added to this paper.
  stickerMm Int
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  items     PrintSheetItem[]

  @@index([userId, updatedAt])
  @@map("print_sheet")
}

/// One copy of a sticker, placed and sized on the paper.
model PrintSheetItem {
  id        String     @id
  sheetId   String
  sheet     PrintSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  stickerId String
  sticker   Sticker    @relation(fields: [stickerId], references: [id], onDelete: Cascade)
  xMm       Float
  yMm       Float
  wMm       Float
  hMm       Float
  sort      Int

  @@index([sheetId, sort])
  @@index([stickerId])
  @@map("print_sheet_item")
}
