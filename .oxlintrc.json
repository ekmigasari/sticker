{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "react-perf", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off"
  },
  "overrides": [
    {
      "files": ["src/components/ui/**/*.tsx", "src/hooks/use-mobile.ts"],
      "rules": {
        "no-shadow": "off",
        "no-underscore-dangle": "off",
        "react/no-unstable-nested-components": "off",
        "react/set-state-in-effect": "off"
      }
    },
    {
      // Prisma names its aggregate selections _sum / _count / _avg / _min / _max.
      "files": ["src/lib/admin.ts"],
      "rules": {
        "no-underscore-dangle": ["warn", { "allow": ["_sum", "_count", "_avg", "_min", "_max"] }]
      }
    }
  ],
  "ignorePatterns": [
    ".output/",
    ".tanstack/",
    "node_modules/",
    "public/",
    "src/routeTree.gen.ts",
    "src/generated/"
  ]
}
